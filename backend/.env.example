# ─── Vouchit backend ───────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

PORT=4000
# Long random string; rotating it logs everyone out. REQUIRED in production —
# the app now refuses to boot without it rather than falling back to a default
# signing key, which would let anyone forge tokens for any account.
JWT_SECRET=
DATABASE_URL=               # mongodb+srv://…  keep minPoolSize=3

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

FRONTEND_URL=http://localhost:3000

# ─── Web3 ──────────────────────────────────────────────────────────────────────
# Chain the API validates against. 84532 = Base Sepolia, 8453 = Base mainnet.
# Defaults to Base Sepolia if unset, so a misconfigured deploy cannot silently
# accept mainnet funds.
WEB3_CHAIN_ID=84532

# JSON-RPC endpoint. The public URLs work; a provider key is more reliable.
#   Base Sepolia: https://sepolia.base.org
#   Base mainnet: https://mainnet.base.org
WEB3_RPC_URL=https://sepolia.base.org

# Deployed VouchitEscrow address. Until this is set, on-chain wagers are
# rejected outright rather than silently accepted.
VOUCHIT_ESCROW_CONTRACT_ADDRESS=

# Relayer key — the contract `owner`, the ONLY address that can resolve
# disputes. Anyone holding it can settle any dispute in their own favour.
# Fund it with gas money and nothing else. Under NODE_ENV=production the API
# refuses to resolve disputes when this is missing, rather than pretending.
ADMIN_RELAYER_PRIVATE_KEY=

# Receives the 2.5% protocol fee. Needs no private key here — the contract only
# ever sends to it. Use a hardware wallet or multisig on mainnet.
TREASURY_ADDRESS=

# Etherscan V2 unified API, used for wallet-age checks in verification tiering.
# Without a key the wallet-age signal is unavailable and every account stays at
# tier 0 (invite-only wagers, 25 USDC / 0.01 ETH cap).
#
# PLAN LIMIT: the free tier serves Base Sepolia (84532) but NOT Base mainnet
# (8453), which answers "Free API access is not supported for this chain". On
# mainnet this signal needs a paid Etherscan plan; without one it reports
# unavailable rather than guessing, so tier 1 becomes unreachable by wallet age.
BASESCAN_API_KEY=
# Override only to point at a different explorer; the chain is selected by
# WEB3_CHAIN_ID, not by this URL.
BASESCAN_API_URL=https://api.etherscan.io/v2/api
