# ─── Vouchit frontend ──────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Everything here is PUBLIC — it ships to the
# browser. Never put a private key or secret in this file.

NEXT_PUBLIC_API_URL=http://localhost:4000

# Which Base network to use: "baseSepolia" (default) or "base" for mainnet.
# Defaults to Sepolia so a misconfigured deploy cannot point at real funds.
NEXT_PUBLIC_CHAIN=baseSepolia

# Optional RPC override. Falls back to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=

# Deployed VouchitEscrow address. Must match the backend's. While unset, the
# create-wager screen shows an "unavailable" banner instead of failing later.
NEXT_PUBLIC_ESCROW_ADDRESS=

# Cloudinary (avatars, dispute evidence)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Paying network fees for users (optional) ──────────────────────────────
# A Coinbase Developer Platform Paymaster URL. When set, passkey users
# (Coinbase Smart Wallet) have their Base network fee paid by Vouchit and need
# no ETH at all, and approval + stake collapse into a single prompt.
#
# Extension wallets like MetaMask are key-pair accounts and cannot be
# sponsored; they keep paying their own gas. The UI only advertises
# sponsorship when the connected wallet actually reports supporting it.
#
# Get one at https://portal.cdp.coinbase.com — create a Paymaster, allowlist
# the VouchitEscrow address and the createWager/joinWager/approve methods, set
# a per-user and global spend cap, then fund the gas balance.
# NEXT_PUBLIC_PAYMASTER_URL=

# Coinbase Onramp app id (optional). Enables "Buy with card or bank" on the
# wallet page, depositing straight into the user's own wallet.
# NEXT_PUBLIC_COINBASE_ONRAMP_APP_ID=

# WalletConnect project id (optional, free). Enables the "mobile wallet"
# option, which reaches Trust, Rainbow, MetaMask mobile, Ledger Live and
# several hundred others. Without it that option is hidden rather than shown
# broken. Get one at https://dashboard.reown.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
